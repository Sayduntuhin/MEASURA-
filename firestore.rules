rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Starter rule: any signed-in user can read/write all jobs
    // and readings, so the team stays in sync. Tighten this
    // later (e.g. restrict by team/role) once you know who
    // should see what.
    match /jobs/{jobId} {
      allow read, write: if request.auth != null;

      match /readings/{readingId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
